# Kopioi tämä tiedostoksi .env.local ja täytä OMAT arvosi.
# Älä koskaan lisää oikeita salaisuuksia GitHubiin.

TMDB_API_READ_ACCESS_TOKEN=your_own_tmdb_read_access_token

# Lisää varsinaisen backendin käyttöönotossa vain oman instanssisi arvot.
DATABASE_URL=your_own_database_url
AUTH_SECRET=generate_your_own_long_random_secret
